# ---------------------------------------------------------------- 第三方素材
# 本地测试用的样本（mimikatz / fscan / comreg 等）与 lloader 运行环境，
# 只在本机保留，不作为源码提交。
samples/

# 第三方汇编器（仓库自带一份方便离线使用）
tools/nasm-2.16.03/

# CLR2SC 页面：提取 clr_*.bin 的唯一来源，仅本地保留
stub/clr/clr2sc_index.html

# ---------------------------------------------------------------- 构建产物
*.bin

# 预编译的加载桩入库，clone 下来就能用（改了 .asm 再用 stub/build.bat 重新生成）
!stub/loader_x64.bin
!stub/loader_x86.bin

# CLR 引导桩同样入库，.NET 链路开箱即用（重新生成需要 stub/clr/clr2sc_index.html）
!stub/clr/*.bin
*.obj
*.o
*.pdb
*.ilk
*.exe

# 打包器/回归脚本的临时文件
build/_stub_tmp.bin

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------- 编辑器/系统
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
